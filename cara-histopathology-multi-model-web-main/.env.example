# Copy to .env (docker-compose reads it automatically)

# auto  : real mode when all 8 trained checkpoints + calibration exist, otherwise Demo Mode
# demo  : always Demo Mode (simulated probabilities, works without PanNuke)
# real  : require trained weights (falls back to demo with a warning if they are missing)
CARA_MODE=auto

# cpu | cuda | auto
CARA_DEVICE=auto

# 1 = build all models in a background thread at start-up
CARA_PRELOAD=1

# comma separated list of allowed browser origins for the API
ALLOWED_ORIGINS=*

# host port of the web UI when using docker-compose
FRONTEND_PORT=3000

# optional overrides (defaults are relative to the project root)
# CARA_PANNUKE_DIR=./data/pannuke
# CARA_CHECKPOINT_DIR=./backend/checkpoints
# CARA_RESULTS_DIR=./backend/results
# CARA_MAX_UPLOAD_MB=15
